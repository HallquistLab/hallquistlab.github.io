{
  "name": "hallquist-lab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "format:check": "prettier --plugin prettier-plugin-astro --check .",
    "format": "prettier --plugin prettier-plugin-astro --write .",
    "archive:prepare": "node scripts/prepare-archive.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:links": "python3 scripts/check-site-links.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.2"
  }
}
