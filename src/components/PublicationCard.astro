---
import { publicationUrl, type Publication } from "../lib/publications";
interface Props {
  paper: Publication;
  variant?: "feature" | "card";
}
const { paper, variant = "card" } = Astro.props;
const base = import.meta.env.BASE_URL;
const Heading = variant === "feature" ? "h2" : "h3";
---

<article
  class:list={[
    "publication-card",
    { "publication-feature": variant === "feature" },
  ]}
>
  <p class="eyebrow">{paper.venue} <span>· {paper.year}</span></p>
  <Heading
    ><a href={publicationUrl(paper, base)}>{paper.shortTitle ?? paper.title}</a
    ></Heading
  >
  <p class="publication-summary">{paper.summary}</p>
  <p class="publication-title">{paper.title}</p>
  <p class="publication-byline">{paper.authorLabel ?? paper.authors}</p>
  <a class="text-link" href={publicationUrl(paper, base)}
    >Read the paper <span aria-hidden="true">↗</span></a
  >
</article>
