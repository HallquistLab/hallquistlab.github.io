---
import { researchProjects } from "../data/projects";
const base = import.meta.env.BASE_URL;
---

<div class="project-grid">
  {
    researchProjects.map((project) => (
      <article class="project-card">
        <p class="eyebrow">{project.stage}</p>
        <h3>
          <a href={`${base}research/${project.id}/`}>{project.name}</a>
        </h3>
        <p class="project-question">{project.title}</p>
        <p>{project.summary}</p>
        <a class="text-link" href={`${base}research/${project.id}/`}>
          About {project.name} <span aria-hidden="true">→</span>
        </a>
      </article>
    ))
  }
</div>
