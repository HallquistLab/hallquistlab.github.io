---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import people from "../data/people.json";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="People"
  description="Meet the Hallquist Lab at Emory University, led by Michael Hallquist."
>
  <PageIntro
    title="People"
    eyebrow="Hallquist Lab at Emory"
    description="A shared interest in how people learn, feel, and make decisions."
  />
  <section class="shell section-space" aria-labelledby="current-team">
    <p class="eyebrow">Our people</p><h2
      class="section-title"
      id="current-team"
    >
      Different perspectives.<br />Shared questions.
    </h2><div class="people-list">
      {
        people.map((person) => (
          <article class="person-profile">
            <>
              <div class="person-monogram" aria-hidden="true">
                {person.initials}
              </div>
              <div>
                <>
                  <p class="eyebrow">{person.role}</p>
                  <h3>{person.name}</h3>
                  <p class="person-position">{person.position}</p>
                  <p>{person.bio}</p>
                  <a class="text-link" href={`mailto:${person.email}`}>
                    {person.email}
                  </a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="community-band">
    <div class="shell community-grid">
      <div>
        <p class="eyebrow">Work with us</p><h2>Bring your questions.</h2>
      </div><div>
        <p>
          Our research sits at the intersection of personality, neuroscience,
          and quantitative methods. Learn about training with the lab and how to
          get in touch.
        </p><a class="text-link" href={`${base}join/`}
          >Training & opportunities <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>
  <div class="shell archive-pointer">
    <h2>People who shaped the lab.</h2><p>
      Our history includes trainees and collaborators at UNC–Chapel Hill and
      Penn State. <a href={`${base}archive/people/`}
        >Explore the historical team profiles.</a
      >
    </p>
  </div>
</BaseLayout>
