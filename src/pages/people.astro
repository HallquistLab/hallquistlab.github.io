---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import people from "../data/people.json";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="People"
  description="Meet the Hallquist Lab at Emory University, led by Michael Hallquist."
>
  <PageIntro
    title="People"
    eyebrow="Hallquist Lab at Emory"
    description="Faculty and graduate researchers in Emory University's Department of Psychology."
  />
  <section class="shell section-space" aria-labelledby="current-team">
    <h2 class="section-title" id="current-team">Lab members</h2><div
      class="people-list"
    >
      {
        people.map((person) => (
          <article class="person-profile">
            <>
              <div class="person-monogram" aria-hidden="true">
                {person.initials}
              </div>
              <div>
                <>
                  <p class="eyebrow">{person.role}</p>
                  <h3>{person.name}</h3>
                  <p class="person-position">{person.position}</p>
                  <p>{person.bio}</p>
                  {"background" in person && <p>{person.background}</p>}
                  <a class="text-link" href={`mailto:${person.email}`}>
                    {person.email}
                  </a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="community-band">
    <div class="shell community-grid">
      <div>
        <h2>Research training</h2>
      </div><div>
        <p>
          Learn about undergraduate research, graduate training, and how to
          contact the lab about current opportunities.
        </p><a class="text-link" href={`${base}join/`}
          >Training & opportunities <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>
</BaseLayout>
