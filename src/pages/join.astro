---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import site from "../data/site.json";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Join the lab"
  description="Learn about research training and opportunities with the Hallquist Lab at Emory University."
>
  <PageIntro
    title="Join the lab"
    eyebrow="Training & opportunities"
    description="Undergraduate research, graduate training, and collaboration."
  />
  <section class="shell section-space prose-layout">
    <div>
      <h2>Working with the lab</h2>
    </div><div class="prose-copy">
      <p class="large-prose">
        Contact Michael Hallquist about research fit and current opportunities.
        Availability varies by role and academic year.
      </p><p>
        Before writing, review our <a href={`${base}research/`}>research</a> and{
          " "
        }
        <a href={`${base}publications/`}>recent work</a>. Include your
        interests, relevant experience, and the type of role and time frame you
        have in mind.
      </p><a
        class="button button-primary"
        href={`mailto:${site.email}?subject=Hallquist%20Lab%20research%20opportunities`}
        >Ask about opportunities <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
  <section
    class="shell opportunity-grid section-space"
    aria-label="Research training pathways"
  >
    <article>
      <h2>Undergraduate research</h2><p>
        Tell us about your interests, relevant coursework or experience, and the
        skills you would like to develop. Contact us to discuss available roles,
        expectations, and possible ways to participate.
      </p>
    </article><article>
      <h2>Graduate training</h2><p>
        Prospective graduate students should review Emory Psychology’s programs
        and admissions information and contact Michael about research fit and
        advising availability for the relevant admissions cycle.
      </p><a class="text-link" href="https://psychology.emory.edu/"
        >Emory Psychology <span aria-hidden="true">↗</span></a
      >
    </article><article>
      <h2>Collaboration</h2><p>
        For questions about research collaborations or other training
        opportunities, send a brief description of your interests and how they
        connect with the lab’s work.
      </p><a class="text-link" href={`${base}contact/`}
        >Get in touch <span aria-hidden="true">→</span></a
      >
    </article>
  </section>
  <section class="shell faq-section">
    <h2 class="section-title">Training questions</h2><details>
      <summary>What backgrounds connect with the lab’s research?</summary><p>
        Our work draws on personality and clinical psychology, cognitive
        neuroscience, statistics, and computational modeling. Tell us how your
        interests and experience relate to the research, and what you want to
        learn.
      </p>
    </details><details>
      <summary>Where can I learn about the methods you use?</summary><p>
        Start with our <a href={`${base}resources/`}
          >software and training resources</a
        >. They cover multilevel modeling, structural equation modeling, R, and
        reproducible research.
      </p>
    </details>
  </section>
</BaseLayout>
