---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import site from "../data/site.json";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Join the lab"
  description="Learn about research training and opportunities with the Hallquist Lab at Emory University."
>
  <PageIntro
    title="Join the lab"
    eyebrow="Training & opportunities"
    description="Research at the intersection of personality, neuroscience, and computational methods."
  />
  <section class="shell section-space prose-layout">
    <div>
      <p class="eyebrow">Start a conversation</p><h2>
        Bring curiosity.<br />Build new skills.
      </h2>
    </div><div class="prose-copy">
      <p class="large-prose">
        We bring together perspectives from psychology, neuroscience,
        statistics, and computation to understand personality and mental health.
      </p><p>
        If you are interested in training with the lab, explore our <a
          href={`${base}research/`}>research</a
        > and <a href={`${base}publications/`}>recent work</a>, then contact
        Michael Hallquist about current opportunities and fit. Availability
        varies by role and academic year.
      </p><a
        class="button button-primary"
        href={`mailto:${site.email}?subject=Hallquist%20Lab%20research%20opportunities`}
        >Ask about opportunities <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
  <section
    class="shell opportunity-grid section-space"
    aria-label="Research training pathways"
  >
    <article>
      <p class="eyebrow">Undergraduate research</p><h2>Learn by doing.</h2><p>
        Tell us about your interests, relevant coursework or experience, and the
        skills you would like to develop. Contact us to discuss available roles,
        expectations, and possible ways to participate.
      </p>
    </article><article>
      <p class="eyebrow">Graduate training</p><h2>Develop your questions.</h2><p
      >
        Prospective graduate students should review Emory Psychology’s programs
        and admissions information and contact Michael about research fit and
        advising availability for the relevant admissions cycle.
      </p><a class="text-link" href="https://psychology.emory.edu/"
        >Emory Psychology <span aria-hidden="true">↗</span></a
      >
    </article><article>
      <p class="eyebrow">Collaboration</p><h2>Connect across fields.</h2><p>
        For questions about research collaborations or other training
        opportunities, send a brief description of your interests and how they
        connect with the lab’s work.
      </p><a class="text-link" href={`${base}contact/`}
        >Get in touch <span aria-hidden="true">→</span></a
      >
    </article>
  </section>
  <section class="shell faq-section">
    <p class="eyebrow">A few starting points</p><h2 class="section-title">
      Questions about working together.
    </h2><details>
      <summary>What backgrounds connect with the lab’s research?</summary><p>
        Our work draws on personality and clinical psychology, cognitive
        neuroscience, statistics, and computational modeling. Different projects
        bring these areas together in different ways. Tell us where your
        interests and experience connect, and what you want to learn.
      </p>
    </details><details>
      <summary>Where can I learn about the methods you use?</summary><p>
        Start with our <a href={`${base}resources/`}
          >software and training resources</a
        >. They cover multilevel modeling, structural equation modeling, R, and
        reproducible research.
      </p>
    </details><details>
      <summary>How do I check whether an opportunity is available?</summary><p>
        Email <a href={`mailto:${site.email}`}>{site.email}</a> with the type of
        role and time frame you have in mind. Graduate applicants should also consult
        the department’s current admissions information.
      </p>
    </details>
  </section>
</BaseLayout>
