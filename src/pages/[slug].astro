---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ArchivePage from "../components/ArchivePage.astro";
import {
  archivedContext,
  pageDescriptions,
  pages,
  renderLegacyHtml,
} from "../lib/legacy";

export function getStaticPaths() {
  const currentPages = new Set([
    "people",
    "publications",
    "join",
    "resources",
    "contact",
  ]);
  return pages
    .filter(
      (page) =>
        !currentPages.has(page.slug) &&
        !archivedContext.has(page.slug) &&
        page.slug !== "diversity-equity",
    )
    .map((page) => ({
      params: { slug: page.slug === "depend-home" ? "unc-home" : page.slug },
      props: { page },
    }));
}
const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const html = renderLegacyHtml(page.html, base);
---

{
  archivedContext.has(page.slug) ? (
    <ArchivePage page={page} />
  ) : (
    <BaseLayout title={page.title} description={pageDescriptions[page.slug]}>
      <PageIntro title={page.title} description={pageDescriptions[page.slug]} />
      <article class:list={["legacy-content shell", `legacy-${page.slug}`]}>
        {html.trim() ? (
          <Fragment set:html={html} />
        ) : (
          <p>
            Explore our <a href={`${base}resources/`}>resources</a> or{" "}
            <a href={`${base}contact/`}>contact the lab</a> for more
            information.
          </p>
        )}
      </article>
    </BaseLayout>
  )
}
