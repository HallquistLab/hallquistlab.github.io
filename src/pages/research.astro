---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ProjectCards from "../components/ProjectCards.astro";
import { researchThemes } from "../data/research";
import { getPublication, publicationUrl } from "../lib/publications";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Research"
  description="Transdiagnostic dimensions of personality and psychopathology studied through computational modeling, cognitive neuroscience, and intensive longitudinal assessment."
>
  <PageIntro
    title="Research"
    eyebrow="Personality & psychopathology"
    description="Explaining individual differences through neurocomputational processes."
  />
  <div class="shell research-intro section-space">
    <p class="large-prose">
      Our lab seeks to understand why people differ in the ways they learn from
      experience, make decisions, experience emotions, and navigate social
      relationships—and how these differences affect mental health. We study
      transdiagnostic dimensions of personality and psychopathology that cut
      across traditional diagnostic categories. Our goal is to explain
      individual differences in these dimensions in terms of the
      neurocomputational processes that give rise to them.
    </p>
    <p class="research-methods-intro">
      We integrate computational models of learning and decision-making with
      functional neuroimaging, intensive longitudinal assessment,
      psychophysiology, and advanced statistical modeling. Current projects
      investigate personality pathology, mood dynamics, social affiliation,
      cooperation, and Pavlovian-instrumental interactions.
    </p><nav class="section-navigation" aria-label="Research themes">
      <a href="#projects">Momentum & LENS <span aria-hidden="true">↓</span></a>
      {
        researchThemes.map((theme) => (
          <a href={`#${theme.id}`}>
            {theme.label} <span aria-hidden="true">↓</span>
          </a>
        ))
      }
    </nav>
  </div>
  <section
    class="shell section-space research-projects"
    id="projects"
    aria-labelledby="projects-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Current & upcoming projects</p><h2
          id="projects-heading"
        >
          Momentum & LENS
        </h2>
      </div>
      <p>
        Momentum investigates how learning and mood influence each other. LENS
        will test whether changes in learning precede emotional distress and
        suicidal thoughts.
      </p>
    </div>
    <ProjectCards />
  </section>
  <div class="shell">
    {
      researchThemes.map((theme) => (
        <section
          class="research-detail"
          id={theme.id}
          aria-labelledby={`title-${theme.id}`}
        >
          <div>
            <>
              <p class="eyebrow">
                {theme.number} / {theme.label}
              </p>
              <h2 id={`title-${theme.id}`}>{theme.question}</h2>
            </>
          </div>
          <div class="research-detail-copy">
            <>
              <p class="large-prose">{theme.description}</p>
              <p>{theme.detail}</p>
              <h3 class="small-heading">Connected projects</h3>
              <p>{theme.projectContext}</p>
              <nav
                class="section-navigation"
                aria-label={`${theme.label} projects`}
              >
                <a href={`${base}research/momentum/`}>Momentum →</a>
                <a href={`${base}research/lens/`}>LENS →</a>
              </nav>
              <h3 class="small-heading">Related work</h3>
              <ul class="related-papers">
                {theme.papers.map((id) => {
                  const paper = getPublication(id);
                  return (
                    <li>
                      <a href={publicationUrl(paper, base)}>
                        {paper.title}
                        <span>
                          {paper.authorLabel ?? paper.authors} · {paper.venue} ·{" "}
                          {paper.year}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </>
          </div>
        </section>
      ))
    }
  </div>
  <section class="community-band">
    <div class="shell community-grid">
      <div>
        <h2>Statistical & computational methods</h2>
      </div><div>
        <p>
          We develop and apply methods for psychometric, behavioral, and
          neuroimaging data, including latent variable and reinforcement
          learning models.
        </p><a class="text-link" href={`${base}resources/`}
          >Software & training materials <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>
  <div class="shell archive-pointer">
    <p>
      Historical descriptions of NeuroMAP, the original Momentum study, and
      ROSES are preserved in the UNC archive. For Momentum's place in our
      current research program, <a href={`${base}research/momentum/`}
        >explore the project overview</a
      >. <a href={`${base}archive/studies/`}
        >Read the historical study descriptions.</a
      >
    </p>
  </div>
</BaseLayout>
