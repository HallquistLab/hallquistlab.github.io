---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
const base = import.meta.env.BASE_URL;
const photos = [
  {
    src: "media/2025/06/DEPENd2025-2-1024x710.jpg",
    alt: "Lab members gathered outdoors at UNC in 2025",
    caption: "The lab at UNC · 2025",
  },
  {
    src: "media/2024/05/lab_staff_retreat2024.jpg",
    alt: "Lab staff together at the 2024 retreat",
    caption: "Lab staff retreat · 2024",
  },
  {
    src: "media/2023/09/Lab_retreat_2023.jpg",
    alt: "Lab members gathered at the 2023 retreat",
    caption: "Lab retreat · 2023",
  },
];
---

<BaseLayout
  title="Life in the lab"
  description="Hallquist Lab members, training resources, and photos from past retreats."
>
  <PageIntro
    title="Life in the lab"
    eyebrow="Hallquist Lab"
    description="Lab members, training resources, and photos from past retreats."
  />
  <nav class="shell section-navigation" aria-label="Lab information">
    <a href={`${base}people/`}>Current team</a>
    <a href={`${base}resources/`}>Training materials</a>
    <a href={`${base}diversity-equity/`}>Community values</a>
  </nav>
  <section class="shell section-space" aria-labelledby="lab-history">
    <h2 class="section-title" id="lab-history">Retreats & gatherings</h2><p
      class="section-description"
    >
      Retreats and gatherings from our years at UNC–Chapel Hill.
    </p><div class="lab-photo-grid">
      {
        photos.map((photo) => (
          <figure>
            <>
              <img
                src={`${base}${photo.src}`}
                alt={photo.alt}
                width="640"
                height="440"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{photo.caption}</figcaption>
            </>
          </figure>
        ))
      }
    </div><div class="button-row">
      <a class="text-link" href={`${base}archive/lab-activities/`}
        >More from the photo archive <span aria-hidden="true">→</span></a
      ><a class="text-link" href={`${base}archive/news/`}
        >Past lab news <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</BaseLayout>
