---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import ProjectCards from "../components/ProjectCards.astro";
import { getPublication } from "../lib/publications";
import { researchThemes } from "../data/research";
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Personality · Neuroscience · Computation</p>
      <h1>Learning, emotion,<br /><em>and mental health.</em></h1>
      <p class="lede">
        We study why people differ in how they learn, make decisions, experience
        emotions, and navigate social relationships—and how these differences
        affect mental health.
      </p>
      <div class="button-row">
        <a class="button button-primary" href={`${base}research/`}
          >Explore our research</a
        >
        <a class="button button-secondary" href={`${base}people/`}
          >Meet the lab</a
        >
      </div>
      <p class="hero-affiliation">
        Department of Psychology <span aria-hidden="true">/</span> Emory University
      </p>
    </div>
    <PublicationCard
      paper={getPublication("vig-hallquist-2026-repair")}
      variant="feature"
    />
  </section>
  <section
    class="research-overview shell section-space"
    aria-labelledby="research-heading"
  >
    <div class="section-heading compact">
      <div>
        <h2 id="research-heading">Explaining individual differences</h2>
      </div>
      <p>
        We integrate transdiagnostic dimensional models, cognitive neuroscience,
        and computational psychiatry to explain personality and psychopathology
        in terms of the neurocomputational processes that give rise to them.
      </p>
    </div>
    <div class="question-grid">
      {
        researchThemes.map((theme) => (
          <a class="question-link" href={`${base}research/#${theme.id}`}>
            <span class="eyebrow">
              <span class="index-number">{theme.number}</span> {theme.label}
            </span>
            <>
              <h3>{theme.question}</h3>
              <p>{theme.description}</p>
              <span class="text-link">
                Related research <span aria-hidden="true">→</span>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="selected-work section-space" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading compact">
        <div>
          <h2 id="work-heading">Selected publications</h2>
        </div><a class="text-link section-link" href={`${base}publications/`}
          >Browse all publications <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="publication-grid">
        {
          ["cv-104", "hallquist-tackett-2026", "cv-102"].map((id) => (
            <PublicationCard paper={getPublication(id)} />
          ))
        }
      </div>
    </div>
  </section>
  <section class="shell section-space" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Current & upcoming projects</p>
        <h2 id="projects-heading">Momentum & LENS</h2>
      </div>
      <p>
        Momentum studies how learning and mood influence each other. LENS will
        extend this work to the emergence of suicidal thoughts.
      </p>
    </div>
    <ProjectCards />
  </section>
  <section class="community-band">
    <div class="shell community-grid">
      <div>
        <h2>Research team</h2>
      </div>
      <div>
        <p>
          The lab is led by Michael Hallquist, Professor in Emory University's
          Department of Psychology.
        </p><div class="button-row">
          <a class="button button-primary" href={`${base}people/`}
            >Meet our people</a
          ><a class="text-link" href={`${base}join/`}
            >Training & opportunities <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </div>
  </section>
  <section class="resource-strip shell">
    <div>
      <p class="eyebrow">Software & training</p><h2>
        Statistical & computational methods
      </h2><p>
        We develop and apply latent variable and reinforcement learning models
        for psychometric, behavioral, and neuroimaging data. Our software,
        workshops, and course materials support this work.
      </p>
    </div><a class="text-link" href={`${base}resources/`}
      >Explore our resources <span aria-hidden="true">→</span></a
    >
  </section>
</BaseLayout>
