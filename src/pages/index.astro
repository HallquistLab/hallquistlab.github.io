---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import ProjectCards from "../components/ProjectCards.astro";
import { getPublication } from "../lib/publications";
import { researchThemes } from "../data/research";
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Personality · Neuroscience · Computation</p>
      <h1>How minds<br /><em>find their way.</em></h1>
      <p class="lede">
        We study how learning, decision-making, and emotion shape personality
        and mental health—and why these processes differ across people.
      </p>
      <div class="button-row">
        <a class="button button-primary" href={`${base}research/`}
          >Explore our research</a
        >
        <a class="button button-secondary" href={`${base}people/`}
          >Meet the lab</a
        >
      </div>
      <p class="hero-affiliation">
        Department of Psychology <span aria-hidden="true">/</span> Emory University
      </p>
    </div>
    <PublicationCard paper={getPublication("cv-104")} variant="feature" />
  </section>
  <section
    class="research-overview shell section-space"
    aria-labelledby="research-heading"
  >
    <div class="section-heading compact">
      <div>
        <p class="eyebrow">The questions that move us</p><h2
          id="research-heading"
        >
          Connecting processes<br />to people.
        </h2>
      </div>
      <p>
        We bring personality science, cognitive neuroscience, and computational
        psychiatry together to understand variation in how people think, feel,
        and act.
      </p>
    </div>
    <div class="question-grid">
      {
        researchThemes.map((theme) => (
          <a class="question-link" href={`${base}research/#${theme.id}`}>
            <span class="eyebrow">
              <span class="index-number">{theme.number}</span> {theme.label}
            </span>
            <>
              <h3>{theme.question}</h3>
              <p>{theme.description}</p>
              <span class="text-link">
                Explore this question <span aria-hidden="true">→</span>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="selected-work section-space" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow">Selected recent work</p><h2 id="work-heading">
            Ideas in focus.
          </h2>
        </div><a class="text-link section-link" href={`${base}publications/`}
          >Browse all publications <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="publication-grid">
        {
          ["hallquist-tackett-2026", "cv-102", "cv-101"].map((id) => (
            <PublicationCard paper={getPublication(id)} />
          ))
        }
      </div>
    </div>
  </section>
  <section class="shell section-space" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A connected research program</p>
        <h2 id="projects-heading">Research underway<br />& ahead.</h2>
      </div>
      <p>
        From the interplay of learning and mood to the emergence of suicidal
        thoughts, Momentum and LENS connect experiments with everyday life.
      </p>
    </div>
    <ProjectCards />
  </section>
  <section class="community-band">
    <div class="shell community-grid">
      <div>
        <p class="eyebrow">Hallquist Lab at Emory</p><h2>
          A shared curiosity<br />about people.
        </h2>
      </div>
      <div>
        <p>
          Led by Michael Hallquist, our lab connects experimental research with
          formal models and the complexity of everyday life. Collaboration and
          quantitative training are part of how we work.
        </p><div class="button-row">
          <a class="button button-primary" href={`${base}people/`}
            >Meet our people</a
          ><a class="text-link" href={`${base}join/`}
            >Training & opportunities <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </div>
  </section>
  <section class="resource-strip shell">
    <div>
      <p class="eyebrow">Open science & training</p><h2>
        Methods worth sharing.
      </h2><p>
        Software, workshops, and teaching materials for modeling behavior,
        brains, and individual differences.
      </p>
    </div><a class="text-link" href={`${base}resources/`}
      >Explore our resources <span aria-hidden="true">→</span></a
    >
  </section>
</BaseLayout>
