---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { researchProjects } from "../../data/projects";
import { researchThemes } from "../../data/research";
import { getPublication, publicationUrl } from "../../lib/publications";

export function getStaticPaths() {
  return researchProjects.map((project) => ({
    params: { project: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const themes = researchThemes.filter((theme) =>
  project.themes.includes(theme.id),
);
---

<BaseLayout title={project.name} description={project.summary}>
  <PageIntro
    title={project.name}
    eyebrow={project.stage}
    description={project.title}
  />
  <div class="shell">
    <section
      class="prose-layout section-space"
      aria-labelledby="overview-heading"
    >
      <div>
        <h2 id="overview-heading">Overview</h2>
      </div>
      <div class="prose-copy">
        <p class="large-prose">{project.introduction}</p>
        <nav class="section-navigation" aria-label="Project sections">
          <a href="#questions">Research questions ↓</a>
          <a href="#methods">Methods ↓</a>
          <a href="#related-work">Related work ↓</a>
        </nav>
      </div>
    </section>
    <section
      class="research-detail"
      id="questions"
      aria-labelledby="questions-heading"
    >
      <div>
        <h2 id="questions-heading">Research questions</h2>
      </div>
      <div class="research-detail-copy">
        <ul class="project-questions">
          {project.questions.map((question) => <li>{question}</li>)}
        </ul>
      </div>
    </section>
    <section
      class="research-detail"
      id="methods"
      aria-labelledby="methods-heading"
    >
      <div>
        <h2 id="methods-heading">Methods</h2>
      </div>
      <div class="research-detail-copy">
        <p class="large-prose">{project.methods}</p>
        <p>{project.approach}</p>
        <a class="text-link" href={`${base}resources/`}
          >Our methods & resources <span aria-hidden="true">→</span></a
        >
      </div>
    </section>
  </div>
  <section class="community-band" aria-labelledby="connection-heading">
    <div class="shell community-grid">
      <div>
        <p class="eyebrow">Momentum & LENS</p><h2 id="connection-heading">
          How the studies relate
        </h2>
      </div>
      <div>
        <p>{project.connection}</p><a
          class="text-link"
          href={`${base}research/${project.companion}/`}
          >{project.companionLabel} <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>
  <div class="shell">
    <section
      class="research-detail"
      id="related-work"
      aria-labelledby="related-heading"
    >
      <div>
        <h2 id="related-heading">Related publications</h2>
      </div>
      <div class="research-detail-copy">
        <ul class="related-papers">
          {
            project.papers.map((id) => {
              const paper = getPublication(id);
              return (
                <li>
                  <a href={publicationUrl(paper, base)}>
                    {paper.title}
                    <span>
                      {paper.authorLabel ?? paper.authors} · {paper.venue} ·{" "}
                      {paper.year}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <h3 class="small-heading">Research themes</h3>
        <nav class="section-navigation" aria-label="Connected research themes">
          {
            themes.map((theme) => (
              <a href={`${base}research/#${theme.id}`}>{theme.label}</a>
            ))
          }
        </nav>
      </div>
    </section>
    <div class="archive-pointer">
      <a class="text-link" href={`${base}research/`}
        >Back to all research <span aria-hidden="true">→</span></a
      >
      {
        project.id === "momentum" && (
          <p>
            The original UNC study overview remains in the{" "}
            <a href={`${base}archive/studies/`}>historical study archive</a>.
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>
