---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import events from "../../data/legacy-events.json";

const formatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
const formatDate = (value: string) => formatter.format(new Date(value.replace(" ", "T")));
---

<BaseLayout
  title="Events archive"
  description="Historical events preserved from the former DEPENd Lab website at UNC–Chapel Hill."
>
  <PageIntro
    eyebrow="UNC archive"
    title="Events"
    description="Historical deadlines and announcements from the former DEPENd Lab website."
  />
  <aside class="archive-note shell">
    <strong>Legacy information</strong>
    <p>
      These events ended in 2021–2022 and are retained only as part of the complete site
      archive. Their application links and UNC contact details are not current.
    </p>
  </aside>
  <section class="event-archive shell">
    {
      events.map((event) => (
        <article>
          <time datetime={event.start}>{formatDate(event.start)}</time>
          <h2>{event.title}</h2>
          <Fragment set:html={event.html} />
          <a href={event.sourceUrl}>Original event record ↗</a>
        </article>
      ))
    }
  </section>
</BaseLayout>
